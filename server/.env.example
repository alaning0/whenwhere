# WhenWhere Server Configuration
# Copy this file to .env and update the values for your setup

# Adapter to use for reading photo metadata
# Options: exif, xmp, google-takeout
ADAPTER=exif

# Directory containing your photos/media files
# Examples:
#   macOS:   /Users/yourname/Pictures/PhotoExport
#   Windows: D:\Photos\Export
#   Linux:   /home/yourname/photos
IMAGES_DIR=./Content

# Directory to store generated thumbnails
# Will be created automatically if it doesn't exist
THUMBNAILS_DIR=./.thumbnails

# Server port (default: 3002)
PORT=3002
