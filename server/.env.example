# WhenWhere Server Configuration (optional in development)
# Prefer configuring paths from the app Settings UI.
# Values here are used as defaults when config.json does not exist.

# Adapter to use for reading photo metadata
# Options: exif, xmp, google-takeout
ADAPTER=exif

# Directory containing your photos/media files
IMAGES_DIR=

# Directory to store generated thumbnails (defaults to IMAGES_DIR/.thumbnails)
THUMBNAILS_DIR=

# Server port
PORT=3002
